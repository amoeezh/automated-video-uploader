# Google AI Studio -> free Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq -> free API key: https://console.groq.com/keys
GROQ_API_KEY=

# Meta Graph API long-lived Page Access Token (see README setup steps)
META_PAGE_ACCESS_TOKEN=

# Instagram professional account's numeric ID (see README setup steps)
IG_USER_ID=

# Used to publish the rendered video as a downloadable asset so Instagram can fetch it
GITHUB_TOKEN=
GITHUB_REPOSITORY=

# Optional: also publish each video as a YouTube Short. Skipped (not fatal) if unset.
# One-time setup: create an OAuth client (Desktop app) in Google Cloud Console with the
# YouTube Data API v3 enabled, then run the OAuth flow once to get a refresh token.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
